# prometheus.yml.j2
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'cadvisor'
    static_configs:
      - targets: ['{{ cadvisor_targets | join("', '") }}']

  - job_name: 'node'
    static_configs:
      - targets: ['{{ node_exporter_targets | join("', '") }}']
